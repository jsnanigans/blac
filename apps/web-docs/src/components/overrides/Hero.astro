---
/*
  Splash hero. Keeps Starlight's Hero contract (one <h1 id="_top">, the hero
  frontmatter's title/tagline/actions) and adds the logo mark, whose "c"
  slides into register with the "b" on load. The tagline's <em> becomes the
  headline; the rest is the lead paragraph.
*/
import { LinkButton } from '@astrojs/starlight/components';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
---

<div class="blac-hero">
  <div class="blac-hero__copy">
    <h1 id="_top" class="blac-hero__title">{title}</h1>
    {tagline && <p class="blac-hero__tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="blac-hero__actions sl-flex">
          {actions.map(
            ({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
              <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
                {text}
                {icon?.html && <Fragment set:html={icon.html} />}
              </LinkButton>
            ),
          )}
        </div>
      )
    }
  </div>

  <svg class="blac-hero__mark" viewBox="4 3 56 56" aria-hidden="true">
    <defs>
      <path id="blac-hero-b" d="M6 12a6 6 0 0 1 12 0v12.4A18 18 0 1 1 6 38z"></path>
      <clipPath id="blac-hero-b-clip"><use href="#blac-hero-b"></use></clipPath>
      <mask id="blac-hero-bite">
        <rect x="0" y="0" width="64" height="64" fill="#fff"></rect>
        <circle cx="57" cy="38" r="11" fill="#000"></circle>
      </mask>
    </defs>
    <use href="#blac-hero-b" fill="var(--blac-blue)"></use>
    <g class="blac-hero__c">
      <circle cx="40" cy="38" r="18" fill="var(--blac-pink)" mask="url(#blac-hero-bite)"></circle>
    </g>
    <g clip-path="url(#blac-hero-b-clip)">
      <g class="blac-hero__c">
        <circle cx="40" cy="38" r="18" fill="var(--blac-indigo)" mask="url(#blac-hero-bite)"></circle>
      </g>
    </g>
  </svg>
</div>

<style>
  .blac-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: center;
    padding-block: clamp(1.5rem, 5vw, 5.5rem) clamp(1rem, 3vw, 3rem);
  }

  .blac-hero__mark {
    order: -1;
    width: clamp(5.5rem, 22vw, 8rem);
    height: auto;
    overflow: visible;
  }

  .blac-hero__title {
    margin: 0;
    color: var(--blac-fg-strong);
    font-family: var(--blac-font-display);
    font-size: clamp(4rem, 1.5rem + 10vw, 8.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.9;
  }

  .blac-hero__tagline {
    max-width: 34rem;
    margin: 1.75rem 0 0;
    color: var(--blac-fg-dim);
    font-size: clamp(1.0625rem, 0.95rem + 0.5vw, 1.3125rem);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .blac-hero__tagline :global(em) {
    display: block;
    margin-bottom: 0.75rem;
    color: var(--blac-pink-text);
    font-family: var(--blac-font-display);
    font-size: clamp(1.625rem, 1.1rem + 1.8vw, 2.5rem);
    font-style: normal;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .blac-hero__actions {
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2.25rem;
  }

  @media (min-width: 50rem) {
    .blac-hero {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: 4rem;
    }

    .blac-hero__mark {
      order: 0;
      justify-self: center;
      width: min(100%, 22rem);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .blac-hero__c {
      animation: blac-hero-c-in 1s cubic-bezier(0.2, 0.9, 0.25, 1.15) 0.15s both;
    }

    .blac-hero__copy > * {
      animation: blac-hero-rise 0.7s var(--blac-ease) both;
    }

    .blac-hero__copy > :nth-child(2) {
      animation-delay: 0.08s;
    }

    .blac-hero__copy > :nth-child(3) {
      animation-delay: 0.16s;
    }
  }

  @keyframes blac-hero-c-in {
    from {
      transform: translateX(18px);
      opacity: 0;
    }
  }

  @keyframes blac-hero-rise {
    from {
      transform: translateY(10px);
      opacity: 0;
    }
  }
</style>
