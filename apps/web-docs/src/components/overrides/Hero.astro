---
/*
  Splash hero override.
  Preserves Starlight's Hero contract (one <h1 id="_top">, frontmatter
  title/tagline/actions) and pairs it with:
    1. A quick-copy install command bar (`pnpm add @blac/core @blac/react`).
    2. An interactive, whimsical "Kinetic State Machine" SVG + control deck
       where firing a state path sends an overprint pulse exclusively to the
       component that read that path.
*/
import { LinkButton } from '@astrojs/starlight/components';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
---

<div class="blac-hero">
  <div class="blac-hero__copy">
    <div class="blac-hero__pill-row">
      <span class="blac-hero__pill">
        <span class="blac-hero__pill-dot" aria-hidden="true"></span>
        <span>Business Logic Components</span>
      </span>
      <span class="blac-hero__pill blac-hero__pill--tag">UI · Logic · Data · Proxy-Tracked</span>
    </div>

    <h1 id="_top" class="blac-hero__title">
      <span class="blac-hero__title-text">{title}</span>
      <span class="blac-hero__title-spark" aria-hidden="true">✦</span>
    </h1>

    {tagline && <p class="blac-hero__tagline" set:html={tagline} />}

    {
      actions.length > 0 && (
        <div class="blac-hero__actions sl-flex">
          {actions.map(
            ({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
              <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
                {text}
                {icon?.html && <Fragment set:html={icon.html} />}
              </LinkButton>
            ),
          )}
        </div>
      )
    }

    <div class="blac-hero__install">
      <div class="blac-hero__install-code">
        <span class="blac-hero__install-prompt" aria-hidden="true">$</span>
        <code>pnpm add @blac/core @blac/react</code>
      </div>
      <button
        type="button"
        class="blac-hero__install-btn"
        data-copy-cmd="pnpm add @blac/core @blac/react"
        aria-label="Copy install command"
      >
        <span class="blac-hero__install-btn-label">Copy</span>
      </button>
    </div>
  </div>

  <div
    class="blac-hero__stage"
    data-active-channel="0"
    aria-label="Interactive diagram showing BlaC proxy dependency tracking"
  >
    <div class="blac-hero__stage-header">
      <span class="blac-hero__stage-dots" aria-hidden="true">
        <i></i><i></i><i></i>
      </span>
      <span class="blac-hero__stage-title">PROXY LENS · PATH ISOLATION</span>
      <span class="blac-hero__stage-status">LIVE</span>
    </div>

    <svg
      class="blac-hero__machine"
      viewBox="0 0 460 320"
      role="img"
      aria-label="A Cubit state container connected through a Proxy lens to three React components: Counter, Avatar, and Theme. Only the component whose state path changes receives a signal pulse."
    >
      <defs>
        <path id="blac-hero-b" d="M46 84a13 13 0 0 1 26 0v24a38 38 0 1 1-26 28.5Z"></path>
        <clipPath id="blac-hero-b-clip"><use href="#blac-hero-b"></use></clipPath>
        <mask id="blac-hero-c-mask">
          <rect x="0" y="0" width="460" height="320" fill="#fff"></rect>
          <circle cx="118" cy="144" r="15.5" fill="#000"></circle>
          <path d="M118 144 L172 110 L172 178 Z" fill="#000"></path>
        </mask>
        <mask id="blac-hero-b-mask">
          <rect x="0" y="0" width="460" height="320" fill="#fff"></rect>
          <circle cx="84" cy="144" r="14.5" fill="#000"></circle>
        </mask>
      </defs>

      <!-- Decorative Bauhaus geometric backdrop grid & registration marks -->
      <g class="blac-hero__grid" aria-hidden="true">
        <circle
          cx="102"
          cy="144"
          r="78"
          fill="none"
          stroke="var(--blac-border-strong)"
          stroke-dasharray="3 6"
          opacity="0.55"></circle>
        <circle
          cx="102"
          cy="144"
          r="98"
          fill="none"
          stroke="var(--blac-border)"
          stroke-dasharray="1 5"
          opacity="0.45"></circle>
        <path
          d="M24 36h10M29 31v10 M426 36h10M431 31v10 M24 288h10M29 283v10"
          stroke="var(--blac-fg-faint)"
          stroke-width="1.5"
          stroke-linecap="round"
          opacity="0.45"></path>
      </g>

      <!-- Signal splines from Proxy Lens (x=148, y=144) to Component Nodes (x=278) -->
      <g class="blac-hero__wires" fill="none" stroke-linecap="round">
        <!-- Channel 0: state.count -> <Counter /> (y=66) -->
        <path
          class="blac-hero__wire blac-hero__wire--0"
          d="M 148 134 C 204 134, 212 66, 276 66"
          stroke="var(--blac-gold)"
          stroke-width="2.5"></path>
        <path
          class="blac-hero__pulse blac-hero__pulse--0"
          d="M 148 134 C 204 134, 212 66, 276 66"
          stroke="var(--blac-gold)"
          stroke-width="4"
           pathLength="100"></path>

        <!-- Channel 1: state.user -> <Avatar /> (y=148) -->
        <path
          class="blac-hero__wire blac-hero__wire--1"
          d="M 152 148 C 205 148, 222 148, 276 148"
          stroke="var(--blac-pink)"
          stroke-width="2.5"></path>
        <path
          class="blac-hero__pulse blac-hero__pulse--1"
          d="M 152 148 C 205 148, 222 148, 276 148"
          stroke="var(--blac-pink)"
          stroke-width="4"
          pathLength="100"></path>

        <!-- Channel 2: state.theme -> <Theme /> (y=230) -->
        <path
          class="blac-hero__wire blac-hero__wire--2"
          d="M 148 160 C 204 160, 212 230, 276 230"
          stroke="var(--blac-mint)"
          stroke-width="2.5"></path>
        <path
          class="blac-hero__pulse blac-hero__pulse--2"
          d="M 148 160 C 204 160, 212 230, 276 230"
          stroke="var(--blac-mint)"
          stroke-width="4"
          pathLength="100"></path>
      </g>

      <!-- The BlaC Overprint Monogram & Proxy Lens Core -->
      <g class="blac-hero__core">
        <!-- Solar Gold offset cap -->
        <circle cx="64" cy="80" r="13" fill="var(--blac-gold)" opacity="0.92"></circle>

        <!-- Cobalt 'b' (Cubit state container) -->
        <g mask="url(#blac-hero-b-mask)">
          <use href="#blac-hero-b" fill="var(--blac-blue)"></use>
        </g>

        <!-- Acid Rose 'c' (Proxy aperture) + Ultraviolet intersection -->
        <g class="blac-hero__c">
          <g mask="url(#blac-hero-c-mask)">
            <circle cx="118" cy="144" r="38" fill="var(--blac-pink)"></circle>
            <circle
              cx="118"
              cy="144"
              r="38"
              fill="var(--blac-indigo)"
              clip-path="url(#blac-hero-b-clip)"></circle>
          </g>
          <!-- Gold 4-point spark inside the 'c' mouth -->
          <path
            class="blac-hero__spark"
            d="M145 131 C145 140 148 143 157 143 C148 143 145 146 145 155 C145 146 142 143 133 143 C142 143 145 140 145 131 Z"
            fill="var(--blac-gold)"></path>
        </g>

        <!-- Floating geometric satellite dots -->
        <circle cx="128" cy="90" r="6.5" fill="var(--blac-mint)"></circle>
        <rect
          x="44"
          y="196"
          width="11"
          height="11"
          rx="2.5"
          transform="rotate(-18 44 196)"
          fill="var(--blac-coral)"></rect>

        <!-- Core caption pill -->
        <g transform="translate(38, 232)">
          <rect
            x="0"
            y="0"
            width="126"
            height="26"
            rx="13"
            fill="var(--blac-surface-2)"
            stroke="var(--blac-border-strong)"></rect>
          <circle cx="14" cy="13" r="4" fill="var(--blac-blue)"></circle>
          <text
            x="25"
            y="17"
            fill="var(--blac-fg-strong)"
            font-family="var(--blac-font-mono)"
            font-size="10.5"
            font-weight="700">AppCubit · Proxy</text
          >
        </g>
      </g>

      <!-- Component Node 0: <Counter /> -->
      <g class="blac-hero__node blac-hero__node--0" transform="translate(276, 36)">
        <rect
          class="blac-hero__node-bg"
          x="0"
          y="0"
          width="164"
          height="60"
          rx="12"
          fill="var(--blac-surface-2)"
          stroke="var(--blac-border-strong)"
          stroke-width="1.5"></rect>
        <circle cx="16" cy="20" r="5" fill="var(--blac-gold)"></circle>
        <text
          x="28"
          y="24"
          fill="var(--blac-fg-strong)"
          font-family="var(--blac-font-display)"
          font-size="13"
          font-weight="750">&lt;Counter /&gt;</text
        >
        <text
          x="16"
          y="44"
          fill="var(--blac-fg-dim)"
          font-family="var(--blac-font-mono)"
          font-size="10.5">state.count</text
        >
        <rect
          x="104"
          y="31"
          width="48"
          height="19"
          rx="9.5"
          fill="var(--blac-surface)"
          stroke="var(--blac-gold)"
          stroke-width="1"></rect>
        <text
          class="blac-hero__node-count"
          data-node-counter="0"
          x="128"
          y="44"
          text-anchor="middle"
          fill="var(--blac-gold-text)"
          font-family="var(--blac-font-mono)"
          font-size="10.5"
          font-weight="700">2x</text
        >
      </g>

      <!-- Component Node 1: <Avatar /> -->
      <g class="blac-hero__node blac-hero__node--1" transform="translate(276, 118)">
        <rect
          class="blac-hero__node-bg"
          x="0"
          y="0"
          width="164"
          height="60"
          rx="12"
          fill="var(--blac-surface-2)"
          stroke="var(--blac-border-strong)"
          stroke-width="1.5"></rect>
        <circle cx="16" cy="20" r="5" fill="var(--blac-pink)"></circle>
        <text
          x="28"
          y="24"
          fill="var(--blac-fg-strong)"
          font-family="var(--blac-font-display)"
          font-size="13"
          font-weight="750">&lt;Avatar /&gt;</text
        >
        <text
          x="16"
          y="44"
          fill="var(--blac-fg-dim)"
          font-family="var(--blac-font-mono)"
          font-size="10.5">state.user</text
        >
        <rect
          x="104"
          y="31"
          width="48"
          height="19"
          rx="9.5"
          fill="var(--blac-surface)"
          stroke="var(--blac-pink)"
          stroke-width="1"></rect>
        <text
          class="blac-hero__node-count"
          data-node-counter="1"
          x="128"
          y="44"
          text-anchor="middle"
          fill="var(--blac-pink-text)"
          font-family="var(--blac-font-mono)"
          font-size="10.5"
          font-weight="700">1x</text
        >
      </g>

      <!-- Component Node 2: <Theme /> -->
      <g class="blac-hero__node blac-hero__node--2" transform="translate(276, 200)">
        <rect
          class="blac-hero__node-bg"
          x="0"
          y="0"
          width="164"
          height="60"
          rx="12"
          fill="var(--blac-surface-2)"
          stroke="var(--blac-border-strong)"
          stroke-width="1.5"></rect>
        <circle cx="16" cy="20" r="5" fill="var(--blac-mint)"></circle>
        <text
          x="28"
          y="24"
          fill="var(--blac-fg-strong)"
          font-family="var(--blac-font-display)"
          font-size="13"
          font-weight="750">&lt;Theme /&gt;</text
        >
        <text
          x="16"
          y="44"
          fill="var(--blac-fg-dim)"
          font-family="var(--blac-font-mono)"
          font-size="10.5">state.theme</text
        >
        <rect
          x="104"
          y="31"
          width="48"
          height="19"
          rx="9.5"
          fill="var(--blac-surface)"
          stroke="var(--blac-mint)"
          stroke-width="1"></rect>
        <text
          class="blac-hero__node-count"
          data-node-counter="2"
          x="128"
          y="44"
          text-anchor="middle"
          fill="var(--blac-mint-text)"
          font-family="var(--blac-font-mono)"
          font-size="10.5"
          font-weight="700">1x</text
        >
      </g>
    </svg>

    <div class="blac-hero__controls" role="group" aria-label="Trigger state mutation">
      <span class="blac-hero__controls-label">Emit change:</span>
      <button type="button" class="blac-hero__trigger" data-channel="0">
        <span class="blac-hero__trigger-dot blac-hero__trigger-dot--0"></span>
        <code>count++</code>
      </button>
      <button type="button" class="blac-hero__trigger" data-channel="1">
        <span class="blac-hero__trigger-dot blac-hero__trigger-dot--1"></span>
        <code>user.name</code>
      </button>
      <button type="button" class="blac-hero__trigger" data-channel="2">
        <span class="blac-hero__trigger-dot blac-hero__trigger-dot--2"></span>
        <code>theme</code>
      </button>
    </div>
  </div>
</div>

<script>
  function initBlacHero() {
    // 1. Copy install command button
    const copyBtns = document.querySelectorAll('[data-copy-cmd]');
    copyBtns.forEach((btn) => {
      if (btn.hasAttribute('data-copy-bound')) return;
      btn.setAttribute('data-copy-bound', 'true');
      btn.addEventListener('click', async () => {
        const cmd = btn.getAttribute('data-copy-cmd');
        if (!cmd) return;
        const label = btn.querySelector('.blac-hero__install-btn-label');
        try {
          await navigator.clipboard.writeText(cmd);
          btn.setAttribute('data-copied', 'true');
          if (label) label.textContent = 'Copied!';
          setTimeout(() => {
            btn.removeAttribute('data-copied');
            if (label) label.textContent = 'Copy';
          }, 1800);
        } catch {
          // Fallback if clipboard permission denied
        }
      });
    });

    // 2. Interactive Kinetic State Machine
    const stage = document.querySelector('.blac-hero__stage');
    if (!stage || stage.hasAttribute('data-stage-bound')) return;
    stage.setAttribute('data-stage-bound', 'true');

    const counts = [2, 1, 1];
    const counters = [0, 1, 2].map((i) =>
      stage.querySelector(`[data-node-counter="${i}"]`),
    );
    const triggers = stage.querySelectorAll('.blac-hero__trigger');

    let activeChannel = 0;
    let autoTimer: ReturnType<typeof setInterval> | undefined;

    const activateChannel = (channel: number, increment: boolean) => {
      activeChannel = channel;
      stage.setAttribute('data-active-channel', String(channel));
      if (increment) {
        counts[channel] += 1;
        const el = counters[channel];
        if (el) el.textContent = `${counts[channel]}x`;
      }
    };

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!prefersReducedMotion) {
      autoTimer = setInterval(() => {
        const next = (activeChannel + 1) % 3;
        activateChannel(next, true);
      }, 2800);
    }

    triggers.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (autoTimer) {
          clearInterval(autoTimer);
          autoTimer = undefined;
        }
        const ch = Number(btn.getAttribute('data-channel') ?? 0);
        activateChannel(ch, true);
      });
    });
  }

  initBlacHero();
  document.addEventListener('astro:after-swap', initBlacHero);
</script>

<style>
  .blac-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
    padding-block: clamp(1.5rem, 4.5vw, 4.5rem) clamp(1.5rem, 3vw, 3rem);
  }

  /* ── Copy Column ── */

  .blac-hero__pill-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .blac-hero__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--blac-border-strong);
    border-radius: 999px;
    background-color: var(--blac-surface);
    color: var(--blac-fg-strong);
    font-family: var(--blac-font-display);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    box-shadow: 2px 2px 0 var(--blac-indigo);
  }

  .blac-hero__pill--tag {
    border-style: dashed;
    background-color: transparent;
    color: var(--blac-fg-dim);
    box-shadow: none;
    font-family: var(--blac-font-mono);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .blac-hero__pill-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--blac-mint);
    box-shadow: 0 0 8px var(--blac-mint);
  }

  .blac-hero__title {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.12em;
    margin: 0;
    color: var(--blac-fg-strong);
    font-family: var(--blac-font-display);
    font-size: clamp(4.25rem, 1.75rem + 9.5vw, 8.25rem);
    font-weight: 800;
    font-variation-settings: 'opsz' 96;
    letter-spacing: -0.045em;
    line-height: 0.88;
  }

  .blac-hero__title-text {
    text-shadow: 4px 4px 0 color-mix(in srgb, var(--blac-indigo) 55%, transparent);
  }

  .blac-hero__title-spark {
    color: var(--blac-gold);
    font-size: 0.34em;
    line-height: 1;
    transform: translateY(0.15em);
    text-shadow: 2px 2px 0 var(--blac-pink);
  }

  .blac-hero__tagline {
    max-width: 35rem;
    margin: 1.5rem 0 0;
    color: var(--blac-fg-dim);
    font-size: clamp(1.0625rem, 0.96rem + 0.45vw, 1.25rem);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .blac-hero__tagline :global(em) {
    display: block;
    margin-bottom: 0.75rem;
    color: var(--blac-pink-text);
    font-family: var(--blac-font-display);
    font-size: clamp(1.75rem, 1.2rem + 1.8vw, 2.65rem);
    font-style: normal;
    font-weight: 780;
    font-variation-settings: 'opsz' 72;
    letter-spacing: -0.03em;
    line-height: 1.08;
  }

  .blac-hero__actions {
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.25rem;
    margin-top: 2rem;
  }

  /* ── Quick-copy Install Bar ── */

  .blac-hero__install {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 100%;
    margin-top: 1.35rem;
    padding: 0.45rem 0.5rem 0.45rem 1rem;
    border: 1px solid var(--blac-border-strong);
    border-radius: 999px;
    background-color: var(--blac-surface);
    box-shadow: 3px 3px 0 color-mix(in srgb, var(--blac-blue) 55%, transparent);
  }

  .blac-hero__install-code {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--blac-font-mono);
    font-size: 0.84rem;
    color: var(--blac-fg-strong);
    overflow-x: auto;
    white-space: nowrap;
  }

  .blac-hero__install-prompt {
    color: var(--blac-pink-text);
    font-weight: 700;
    user-select: none;
  }

  .blac-hero__install-btn {
    cursor: pointer;
    padding: 0.32rem 0.85rem;
    border: 1px solid var(--blac-border-strong);
    border-radius: 999px;
    background-color: var(--blac-surface-2);
    color: var(--blac-fg-strong);
    font-family: var(--blac-font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s var(--blac-ease-spring);
  }

  .blac-hero__install-btn:hover {
    border-color: var(--blac-gold);
    background-color: var(--blac-surface-3);
    transform: scale(1.04);
  }

  .blac-hero__install-btn[data-copied='true'] {
    border-color: var(--blac-mint);
    background-color: var(--blac-mint);
    color: #0b0a12;
  }

  /* ── Right Column: Kinetic State Machine Stage ── */

  .blac-hero__stage {
    position: relative;
    border: 1px solid var(--blac-border-strong);
    border-radius: var(--blac-radius-xl);
    background-color: var(--blac-surface);
    background-image:
      linear-gradient(to right, var(--blac-grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--blac-grid-line) 1px, transparent 1px);
    background-size: 24px 24px;
    box-shadow:
      6px 6px 0 var(--blac-indigo),
      var(--blac-shadow-soft);
    overflow: hidden;
  }

  .blac-hero__stage-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--blac-border);
    background-color: color-mix(in srgb, var(--blac-surface-2) 88%, transparent);
    font-family: var(--blac-font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--blac-fg-dim);
  }

  .blac-hero__stage-dots {
    display: inline-flex;
    gap: 0.35rem;
  }

  .blac-hero__stage-dots i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    display: inline-block;
  }

  .blac-hero__stage-dots i:nth-child(1) {
    background-color: var(--blac-pink);
  }
  .blac-hero__stage-dots i:nth-child(2) {
    background-color: var(--blac-gold);
  }
  .blac-hero__stage-dots i:nth-child(3) {
    background-color: var(--blac-mint);
  }

  .blac-hero__stage-status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.12rem 0.5rem;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--blac-mint) 18%, transparent);
    color: var(--blac-mint-text);
    font-size: 0.65rem;
  }

  .blac-hero__stage-status::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background-color: var(--blac-mint);
  }

  .blac-hero__machine {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Wire & Node Channel Highlighting */

  .blac-hero__wire {
    opacity: 0.25;
    stroke-dasharray: 4 5;
    transition: opacity 0.25s ease;
  }

  .blac-hero__pulse {
    opacity: 0;
