---
// Same contract as Starlight's PageTitle (single <h1 id="_top">), set in the display face.
---

<h1 id="_top" class="page-title">{Astro.locals.starlightRoute.entry.data.title}</h1>

<style>
  .page-title {
    margin-top: 1.5rem;
    color: var(--blac-fg-strong);
    font-family: var(--blac-font-display);
    font-size: var(--sl-text-h1);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    text-wrap: balance;
  }
</style>
