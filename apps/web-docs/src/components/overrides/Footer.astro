---
import EditLink from '@astrojs/starlight/components/EditLink.astro';
import LastUpdated from '@astrojs/starlight/components/LastUpdated.astro';
import Pagination from '@astrojs/starlight/components/Pagination.astro';
---

<footer class="blac-footer sl-flex">
  <div class="blac-footer__meta sl-flex">
    <EditLink />
    <LastUpdated />
  </div>

  <Pagination />

  <div class="blac-footer__colophon">
    <p class="blac-footer__llm" aria-label="LLM context files">
      <span class="blac-footer__label">LLM context</span>
      <a href="/llms.txt">llms.txt</a>
      <a href="/llms-blac.txt">@blac/core</a>
      <a href="/llms-blac-react.txt">@blac/react</a>
      <a href="/llms-dirtytalk.txt">@blac/dirty-talk</a>
      <a href="/llms-full.txt">full corpus</a>
    </p>
    <p class="blac-footer__imprint">
      <svg viewBox="0 0 18 12" width="18" height="12" aria-hidden="true">
        <circle cx="6" cy="6" r="5" fill="var(--blac-blue)"></circle>
        <circle cx="12" cy="6" r="5" fill="var(--blac-pink)"></circle>
        <path d="M9 2a5 5 0 0 1 0 8a5 5 0 0 1 0-8z" fill="var(--blac-indigo)"></path>
      </svg>
      Edition 2026, printed with BlaC
    </p>
  </div>
</footer>

<style>
  .blac-footer {
    flex-direction: column;
    gap: 2rem;
    margin-top: 3rem;
  }

  .blac-footer__meta {
    gap: 0.75rem 3rem;
    justify-content: space-between;
    flex-wrap: wrap;
    padding-top: 1.5rem;
    border-top: 1px solid var(--blac-border);
    font-size: var(--sl-text-sm);
    color: var(--blac-fg-faint);
  }

  .blac-footer__meta > :global(p:only-child) {
    margin-inline-start: auto;
  }

  .blac-footer__colophon {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 2rem;
    padding-block: 1.5rem 1rem;
    border-top: 1px solid var(--blac-border);
    color: var(--blac-fg-faint);
    font-size: 0.8125rem;
  }

  .blac-footer__colophon p {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.9rem;
    margin: 0;
  }

  .blac-footer__label {
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.6875rem;
  }

  .blac-footer__llm a {
    color: var(--blac-fg-dim);
    text-decoration: none;
  }

  .blac-footer__llm a:hover {
    color: var(--blac-link);
    text-decoration: underline;
    text-decoration-color: var(--blac-pink);
    text-underline-offset: 0.22em;
  }

  .blac-footer__colophon .blac-footer__imprint {
    gap: 0.5rem;
  }
</style>
