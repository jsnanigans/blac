---
interface Props {
  title: string;
  /** Jack colour: modules are cobalt, components rose, wiring cable. */
  tone?: 'cobalt' | 'rose' | 'cable' | 'lit';
}
const { title, tone = 'cable' } = Astro.props;
---

<article class="card" data-tone={tone}>
  <p class="card-title"><span class="jack" aria-hidden="true"></span>{title}</p>
  <div class="card-body"><slot /></div>
</article>

<style>
  .card {
    --c: var(--cable);
    padding: 1.15rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
  }

  .card[data-tone='cobalt'] {
    --c: var(--cobalt);
  }

  .card[data-tone='rose'] {
    --c: var(--rose);
  }

  .card[data-tone='lit'] {
    --c: var(--lit);
  }

  .card-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .jack {
    background: radial-gradient(circle, var(--bg) 0 30%, var(--c) 32% 100%);
  }

  .card-body {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .card-body :global(> :last-child) {
    margin-bottom: 0;
  }
</style>
