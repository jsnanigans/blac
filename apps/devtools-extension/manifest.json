{
  "manifest_version": 3,
  "name": "BlaC DevTools",
  "version": "3.0.0",
  "description": "Chrome DevTools extension for BlaC state management",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [],
  "host_permissions": [],
  "background": {
    "service_worker": "dist/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content/content-script.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "devtools_page": "dist/src/devtools/devtools.html"
}
