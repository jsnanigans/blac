{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vitest/globals"],
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "../..",
    "paths": {
      "@blac/devtools-connect/client": ["../devtools-connect/dist/client.d.ts"],
      "@blac/devtools-connect/protocol": [
        "../devtools-connect/dist/protocol.d.ts"
      ]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
