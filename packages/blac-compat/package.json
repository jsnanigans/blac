{
  "name": "@9amhealth/blac-compat",
  "version": "0.0.2",
  "private": true,
  "description": "Compatibility shim exposing v0 (blac) and v1 (blac-next + @blac/react) APIs backed by v2 (@blac/core + @blac/react) internals. Intended to be moved to user-fe-reviews.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vp pack --watch",
    "build": "vp pack && tsc -p tsconfig.build.json && cp dist/index.d.ts dist/index.d.cts",
    "clean": "rm -rf dist",
    "format": "vp fmt \".\"",
    "format:check": "vp fmt \".\" --check",
    "lint": "vp lint src",
    "lint:fix": "vp lint src --fix",
    "test": "vp test run",
    "test:watch": "vp test --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@blac/core": "workspace:*",
    "@blac/react": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "^16.3.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
